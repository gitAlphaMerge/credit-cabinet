# Шаблон конфигурации. Скопируйте в .env рядом с docker-compose.yml и заполните:
#   cp .env.example .env        (Windows PowerShell: Copy-Item .env.example .env)
# Файл .env в git не попадает (.gitignore). Настоящий API-ключ в репозиторий не добавлять.
# Все значения меняются здесь, без правки кода; после правки: docker compose up -d --build

# --- Модель агента: любой OpenAI-совместимый провайдер ---
# Полный адрес chat completions, включая путь /v1/chat/completions.
# Пусто = режим без модели: агент отвечает шаблонами, весь сценарий проходит.
# По умолчанию локальная Ollama на хосте (из контейнера она видна как host.docker.internal).
AGENT_LLM_URL=http://host.docker.internal:11434/v1/chat/completions
# Имя модели у провайдера. По умолчанию Qwen3-8B (открытые веса, Apache 2.0) в Ollama.
AGENT_LLM_MODEL=qwen3:8b
# Ключ провайдера. Для локальной Ollama оставить пустым (заголовок Authorization не отправляется).
AGENT_LLM_API_KEY=
# Таймаут одного вызова модели, секунды. По истечении агент отвечает шаблоном.
AGENT_LLM_TIMEOUT=30
# Память клиента между сессиями: 1 включает (+1 вызов модели на ход), 0 выключено.
AGENT_MEMORY=0

# --- Порты на хосте ---
FRONTEND_PORT=80
ALFA_PORT=4173

# --- Необязательное ---
# Токен выгрузки отзывов из кабинета; пусто = выгрузка закрыта.
FEEDBACK_EXPORT_TOKEN=
# Выход агента к провайдеру через HTTP-прокси, если провайдер режет IP сервера (http://host:port).
# AGENT_LLM_PROXY=
