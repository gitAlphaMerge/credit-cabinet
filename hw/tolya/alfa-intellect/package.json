{
  "name": "alfa-intellect",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "tsx watch server/index.ts",
    "start": "tsx server/index.ts",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "fixtures": "tsx scripts/fixtures.ts",
    "format": "prettier --write src server shared scripts tests vite.config.ts tsconfig.json package.json",
    "format:check": "prettier --check src server shared scripts tests vite.config.ts tsconfig.json package.json",
    "verify": "npm run format:check && npm run build && npm test"
  },
  "overrides": {
    "exceljs": {
      "uuid": "11.1.1"
    },
    "mammoth": {
      "argparse": "2.0.1"
    }
  },
  "dependencies": {
    "dotenv": "^18.0.8",
    "exceljs": "^4.4.0",
    "express": "^5.3.0",
    "lucide-react": "^1.58.0",
    "mammoth": "^1.13.0",
    "multer": "^2.4.0",
    "openai": "^7.34.0",
    "pdf-parse": "^2.4.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.5",
    "@types/pdfkit": "^0.17.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^6.1.2",
    "docx": "^9.11.0",
    "pdfkit": "^0.20.2",
    "prettier": "^3.9.10",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
