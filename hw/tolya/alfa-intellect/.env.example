PORT=4173
HOST=127.0.0.1
DATABASE_PATH=var/alfa.sqlite
# OpenAI: только экспериментальная разработка, не входит в проверяемую версию.
# Включается только явным AI_PROVIDER=openai, опционально, не для проверки.
# AI_PROVIDER=openai
# OPENAI_API_KEY=
# AI_MODEL=
TEAM_AGENT_URL=http://127.0.0.1:8090
AI_DAILY_CALL_LIMIT=20
DADATA_API_KEY=
FNS_API_KEY=
# Без ключей реестра автоматически используется локальный мок. mock включает его явно.
EGR_PROVIDER=mock
TEAM_API_URL=http://127.0.0.1:8080
COOKIE_SECURE=false
# Учётки жюри: телефон:пароль через точку с запятой, заводятся при старте сервера.
# JURY_ACCOUNTS=79000000001:пароль-от-8-символов;79000000002:...
