# VS Code REST Client. Запускать блоки по порядку. Cookie-jar REST Client должен быть включён.
# Все телефоны и компании синтетические. Никакие сообщения наружу не отправляются.
# @base для кабинета, @scoreBase для frontend → Go; порты не взаимозаменяемы.
@base = http://localhost:4173
@scoreBase = http://localhost/api
@goBase = http://localhost:8080
@mlBase = http://127.0.0.1:5000
# agentBase доступен только из сети Compose, не из браузера/REST Client на хосте.
@agentBase = http://agent:8090
@chatId = {{createChat.response.body.$.id}}
@docId = {{uploadDoc.response.body.$.id}}
@selectionId = {{createSelection.response.body.$.id}}
@version = {{createSelection.response.body.$.version}}

### Go health
GET {{goBase}}/health


### ml-model health, внутренний сервис через loopback
GET {{mlBase}}/health


### Кабинет health
GET {{base}}/health


### Кабинет API health
GET {{base}}/api/health


### Конфигурация
GET {{base}}/api/config


### Демо без сессии
GET {{base}}/api/public-demo?kind=ooo


### Публичный расчёт
POST {{base}}/api/public-demo/calculate
Content-Type: application/json

{
  "kind": "ooo",
  "amount": 3000000,
  "term": 36
}

### Регистрация, 409 при повторе: поменяйте синтетический номер
POST {{base}}/api/auth/register
Content-Type: application/json

{
  "phone": "+7 900 000-00-01",
  "password": "DemoOnly-2026",
  "profile": {
    "name": "ООО «Тест жюри»",
    "form": "ООО",
    "stage": "operating",
    "sector": "Производство",
    "registered": true,
    "ageBand": "3–5 лет",
    "result": "Прибыль",
    "debt": "Нет",
    "intent": "Проверка"
  }
}

### Вход в созданную учётку
POST {{base}}/api/auth/login
Content-Type: application/json

{
  "phone": "+7 900 000-00-01",
  "password": "DemoOnly-2026"
}

### Альтернатива регистрации: новое изолированное демо, запустите перед остальными запросами
# @name demoLogin
POST {{base}}/api/auth/demo
Content-Type: application/json

{
  "kind": "ooo"
}

### Сохранённое состояние
GET {{base}}/api/state


### Обновить профиль
PATCH {{base}}/api/profile
Content-Type: application/json

{
  "name": "ООО «Синтетический пример»",
  "sector": "Производство"
}

### Настройки
PATCH {{base}}/api/preferences
Content-Type: application/json

{
  "split": 60,
  "tourDone": true
}

### Компания из локального мока
POST {{base}}/api/lookup
Content-Type: application/json

{
  "inn": "9900000001"
}

### Подтвердить найденного кандидата в течение 10 минут
POST {{base}}/api/lookup/confirm
Content-Type: application/json

{
  "inn": "9900000001"
}

### Загрузить синтетическую выписку кабинета
# @name uploadDoc
POST {{base}}/api/documents
Content-Type: multipart/form-data; boundary=DemoBoundary

--DemoBoundary
Content-Disposition: form-data; name="category"

statement
--DemoBoundary
Content-Disposition: form-data; name="file"; filename="statement.csv"
Content-Type: text/csv

< ../hw/tolya/alfa-intellect/fixtures/statement.csv
--DemoBoundary--

### Подтвердить извлечённый документ
POST {{base}}/api/documents/{{docId}}/confirm


### Скачать исходный файл
GET {{base}}/api/documents/{{docId}}/download


### Данные и каталог подбора
GET {{base}}/api/financing/context


### Создать версию 1 подбора, локальный движок
# @name createSelection
POST {{base}}/api/selections
Content-Type: application/json

{
  "engine": "mvp-2",
  "input": {
    "purpose": "Оборудование",
    "amount": 3000000,
    "term": 36,
    "needed": "month",
    "usage": "once",
    "description": "Синтетический станок",
    "repayFrom": "Текущая деятельность",
    "productId": "investment",
    "cycleDays": 30,
    "details": {},
    "financials": {
      "flow": 420000,
      "existing": 0
    }
  }
}

### Legacy-подбор, отдельный пример, не меняет selectionId выше
POST {{base}}/api/selections
Content-Type: application/json

{
  "purpose": "Кассовый разрыв",
  "amount": 100000,
  "term": 3,
  "flow": 420000,
  "existing": 0,
  "repayFrom": "Выручка"
}

### Предварительный вид демо-заявки
GET {{base}}/api/selections/{{selectionId}}/application-preview


### Сохранить демо-заявку, повтор идемпотентен в рамках версии
POST {{base}}/api/selections/{{selectionId}}/application
Content-Type: application/json

{
  "expectedVersion": {{version}},
  "acknowledgeRisks": true
}

### Создать чат до расчёта
# @name createChat
POST {{base}}/api/chats
Content-Type: application/json

{}

### Название чата
PATCH {{base}}/api/chats/{{chatId}}
Content-Type: application/json

{
  "title": "Проверка жюри"
}

### Начать разговор с агентом
POST {{base}}/api/chats/{{chatId}}/messages
Content-Type: application/json

{
  "text": "Нужны 3 млн на оборудование на 36 месяцев, верну из выручки"
}

### Сохранить показатель со слов пользователя
POST {{base}}/api/financials
Content-Type: application/json

{
  "field": "freeFlow",
  "value": 420000
}

### Legacy: локальная демо-заявка
POST {{base}}/api/leads
Content-Type: application/json

{ "selectionId": "{{selectionId}}", "phone": "+7 900 000-00-01" }

### Локальное обращение, никому не отправляется
POST {{base}}/api/consultations
Content-Type: application/json

{
  "phone": "+7 900 000-00-01",
  "note": "Синтетическая проверка сохранения обращения"
}

### JSON-досье
GET {{base}}/api/dossier/{{selectionId}}


### Синтетический кредит
POST {{base}}/api/credit/demo


### Предположения прогноза
POST {{base}}/api/forecast-assumptions
Content-Type: application/json

{
  "balance": 850000,
  "incoming": 1200000,
  "expenses": 780000
}

### Стресс-прогноз
POST {{base}}/api/credit/forecast
Content-Type: application/json

{
  "stress": true
}

### Прочитать уведомления
POST {{base}}/api/notifications/read
Content-Type: application/json

{}

